{
	"name": "neatous/coordinates",
	"description": "Parser and formatter of geographic coordinates, a PHP port of the geo-coordinates-parser JavaScript library",
	"keywords": ["coordinates", "gps", "latitude", "longitude", "parser", "formatter", "geo"],
	"type": "library",
	"license": "MIT",
	"homepage": "https://github.com/neatous/coordinates",
	"authors": [
		{
			"name": "Jaroslav Líbal"
		}
	],
	"support": {
		"issues": "https://github.com/neatous/coordinates/issues",
		"source": "https://github.com/neatous/coordinates"
	},
	"require": {
		"php": "^8.4",
		"ext-mbstring": "*"
	},
	"require-dev": {
		"phpstan/phpstan": "^2.3",
		"phpunit/phpunit": "^13.0",
		"slevomat/coding-standard": "^8.31",
		"squizlabs/php_codesniffer": "^4.0"
	},
	"autoload": {
		"psr-4": {
			"Neatous\\Coordinates\\": "src/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"Neatous\\Coordinates\\Tests\\": "tests/"
		}
	},
	"extra": {
		"branch-alias": {
			"dev-master": "1.1.x-dev"
		}
	},
	"config": {
		"sort-packages": true,
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	}
}
